# Runtime
NODE_ENV=development
PORT=3003
FRONTEND_URL=http://localhost:3005
# Production: comma-separated exact HTTPS origins for frontend and admin UI.
CORS_ALLOWED_ORIGINS=
TRUST_PROXY_HOPS=1

# Required production secrets: use unique, strong deployment-managed values.
DATABASE_URL=postgresql://user:password@localhost:5432/alphabag
JWT_SECRET=replace-with-at-least-32-random-characters
CEX_ENCRYPTION_KEY=replace-with-64-hexadecimal-characters

# Optional provider credentials; configure only on the backend.
ALCHEMY_API_KEY=
COINGECKO_API_KEY=
COINSTATS_API_KEY=
COVALENT_API_KEY=
MORALIS_API_KEY=
NANSEN_API_KEY=
GEMINI_API_KEY=
BSCSCAN_API_KEY=
ETHERSCAN_API_KEY=
ZERION_API_KEY=
CAPTCHA_SECRET_KEY=
CAPTCHA_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
TREASURY_WALLET=
TREASURY_PRIVATE_KEY=
ADMIN_WALLETS=
OUTBOUND_SERVER_IP=

# Optional backend feature and operations settings
REDIS_URL=
ADMIN_SETUP_SECRET=
LOCAL_ADMIN_PREVIEW_EMAIL=
LOCAL_ADMIN_PREVIEW_PASSWORD=
ALLOW_DEV_AUTH_BYPASS=false
ENABLE_TOKEN_GATING=false
IS_TEASER_MODE=false
ENABLE_ALPHA_AI=true
ENABLE_SECURITY_SCANNER=true
DISABLED_PAGES=
MAX_PORTFOLIOS=5
MAX_WHALES=5
AI_DAILY_LIMIT_ULTIMATE=2000
SCHEMA_VALIDATION_STRICT=false
BAG_TOKEN_ADDRESS=
MIN_BAG_REQUIRED=10000
PROVIDER_HEALTH_TIMEOUT_MS=5000
PROVIDER_HEALTH_CACHE_MS=15000

# Optional chain RPC overrides
ETHEREUM_RPC_URL=
BSC_RPC_URL=
POLYGON_RPC_URL=
ARBITRUM_RPC_URL=
BASE_RPC_URL=
AVALANCHE_RPC_URL=
SOLANA_RPC_URL=