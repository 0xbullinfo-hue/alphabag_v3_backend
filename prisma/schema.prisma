// ============================================================
// AlphaBAG V3 — Prisma Schema
// Maps all JSON data collections to PostgreSQL tables
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── USER ────────────────────────────────────────────────────────────────────
// Core user identity, balances, airdrop submission, and referral tracking.

model User {
  id                  String    @id
  email               String?   @unique
  username            String?
  tier                String    @default("FREE")
  isBanned            Boolean   @default(false)
  strikes             Int       @default(0)

  // Balances
  items               Float     @default(0)
  bagTokens           Float     @default(0)
  lifetimeEarned      Float     @default(0)
  aipoints            Int       @default(0)

  // Wallet
  verifiedWallet      String?
  submittedWallet     String?
  preferredWallet     String?

  // Airdrop submission
  airdropSubmitted    Boolean   @default(false)
  airdropSubmittedAt  DateTime?
  xLink               String?
  reviewComment       String?

  // Founder application fields
  isFounderAirdrop    Boolean   @default(false)
  founderStatus       String?   @default("PENDING")
  projectName         String?
  projectTicker       String?
  projectManifesto    String?
  projectSocial       String?
  projectWebsite      String?
  projectContract     String?
  projectGoals        String?
  founderSocial       String?
  projectLogo         String?
  projectBanner       String?

  // Referral
  referralCode        String?   @unique
  referredBy          String?
  referralCount       Int       @default(0)

  // Task tracking (serialized as JSON arrays/objects)
  completedTasks      String[]  @default([])
  claimsHistory       Json      @default("[]")
  submittedLinks      Json      @default("[]")
  weeklyTasks         Json      @default("{}")

  // Activity tracking
  visits              Int       @default(0)
  lastLoginIp         String?
  lastActive          DateTime?
  lastDailyTaskAt     DateTime?
  lastWeeklyTaskAt    DateTime?
  syndicateRank       String?   @default("RECRUIT")

  // Relations
  t2eClaims           T2EClaim[]
  payoutRequests      T2EPayoutRequest[]
  submittedPairs      UserSubmittedPair[]
  cexConnections      CexConnection[]
  whaleFollows        WhaleFollow[]
  trades              Trade[]
  portfolioSnapshots  PortfolioSnapshot[]
  defiPositions       DefiPosition[]
  cexAssets           CexAsset[]

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("users")
}

// ─── ADMIN ───────────────────────────────────────────────────────────────────

model Admin {
  id        String    @id
  wallet    String?   @unique
  email     String?   @unique
  password  String?
  addedBy   String?
  addedAt   DateTime? @default(now())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("admins")
}

// ─── NEWS ────────────────────────────────────────────────────────────────────

model News {
  id          String   @id
  title       String
  summary     String?
  content     String?
  category    String?
  tier        String   @default("FREE")
  imageUrl    String?
  source      String?
  isPremium   Boolean  @default(false)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("news")
}

// ─── SIGNALS ─────────────────────────────────────────────────────────────────

model Signal {
  id        String   @id
  pair      String
  type      String   // BUY | SELL | HOLD
  entry     String?
  stopLoss  String?
  targets   String[] @default([])
  narrative String?
  category  String?  // SWING | SCALP | LONG
  risk      String?  // LOW | MEDIUM | HIGH
  status    String   @default("ACTIVE")
  timestamp String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("signals")
}

// ─── PROJECTS ────────────────────────────────────────────────────────────────

model Project {
  id          String   @id
  name        String
  ticker      String?
  description String?
  website     String?
  twitter     String?
  telegram    String?
  contract    String?
  chain       String?
  category    String?
  status      String   @default("ACTIVE")
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("projects")
}

// ─── AIRDROP CAMPAIGN ────────────────────────────────────────────────────────

model AirdropCampaign {
  id                  String   @id
  tokenTicker         String   @default("🔒")
  pointsPerClaim      Int      @default(50)
  durationDays        Int      @default(7)
  startDate           DateTime @default(now())
  status              String   @default("ACTIVE")
  isSubmissionActive  Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("airdrop_campaigns")
}

// ─── T2E MISSIONS ────────────────────────────────────────────────────────────

model T2EMission {
  id           String   @id
  title        String
  description  String?
  rewardTokens Float    @default(0)
  rewardXP     Float    @default(0)
  type         String   @default("SOCIAL")    // SOCIAL | REFERRAL | FINAL_REVIEW
  frequency    String   @default("ONCE")      // ONCE | DAILY | WEEKLY | UNLIMITED
  requiresLink Boolean  @default(false)
  actionUrl    String?
  platform     String?  @default("SOCIAL")
  category     String?  @default("GENERAL")
  status       String   @default("ACTIVE")    // ACTIVE | Paused | ARCHIVED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  claims       T2EClaim[]

  @@map("t2e_missions")
}

// ─── T2E CLAIMS ──────────────────────────────────────────────────────────────

model T2EClaim {
  id           String     @id
  userId       String
  missionId    String
  proofLink    String?
  feedback     String?
  rewardTokens Float      @default(0)
  rewardXP     Float      @default(0)
  createdAt    DateTime   @default(now())
  // Encodes the uniqueness window for this claim: just `missionId` for a
  // ONCE mission, `missionId:YYYY-MM-DD` for DAILY, `missionId:YYYY-Www`
  // for WEEKLY (computed in t2eController.js's computeClaimWindow()). The
  // unique constraint below is what actually prevents a double-claim
  // under concurrent requests — Postgres rejects the second insert
  // outright, rather than the application racing to check-then-write.
  // DO NOT apply this via `prisma db push` directly against production —
  // run prisma/manual_migrations/001_t2e_claim_uniqueness.sql first to
  // de-duplicate any existing race-condition damage, or the push will
  // fail on the first duplicate row it finds.
  claimWindow  String     @default("")

  user         User       @relation(fields: [userId], references: [id])
  mission      T2EMission @relation(fields: [missionId], references: [id])

  @@unique([userId, claimWindow])
  @@map("t2e_claims")
}

// ─── T2E ACTIVITY FEED ───────────────────────────────────────────────────────

model T2EActivity {
  id           String   @id
  userHandle   String
  taskType     String
  pointsEarned Float    @default(0)
  createdAt    DateTime @default(now())

  @@map("t2e_activity")
}

// ─── T2E PAYOUT REQUESTS ─────────────────────────────────────────────────────

model T2EPayoutRequest {
  id             String    @id
  userId         String
  expectedTokens Float
  walletAddress  String
  status         String    @default("PENDING")  // PENDING | APPROVED | REJECTED | SENT
  txHash         String?
  txReference    String?
  sentAt         DateTime?
  processedBy    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation(fields: [userId], references: [id])

  @@map("t2e_payout_requests")
}

// ─── LEGACY TASKS (airdropController tasks store) ────────────────────────────

model Task {
  id           String   @id
  title        String?
  description  String?
  type         String   @default("once")     // once | daily | weekly | unlimited
  rewardTokens Float    @default(0)
  requiresLink Boolean  @default(false)
  actionUrl    String?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("tasks")
}

// ─── USER SUBMITTED PAIRS ────────────────────────────────────────────────────

model UserSubmittedPair {
  id              String    @id
  userId          String
  contractAddress String    @unique
  chainId         String?
  symbol          String?
  name            String?
  priceUsd        String?
  liquidity       Float?
  dexUrl          String?
  isBoosted       Boolean   @default(false)
  boostExpiry     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id])

  @@map("user_submitted_pairs")
}

model CexConnection {
  id                  String   @id
  userId              String
  exchangeId          String
  encryptedApiKey     String
  encryptedSecret     String
  encryptedPassphrase String?
  status              String   @default("CONNECTED")
  lastSyncedAt        DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, exchangeId])
    cexAssets           CexAsset[]

  @@map("cex_connections")
}

// ─── SYSTEM CONFIG ───────────────────────────────────────────────────────────
// Generic key-value store for singleton configs:
// reveal, missionSettings, t2e_config, activity feed, etc.

model SystemConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("system_configs")
}

// ─── WHALE FOLLOWS (v3-fixes) ────────────────────────────────────────────────
// Per-user tracked whale wallets. Persisted follows power the
// cron/check_followed_whales.js alerting (previously a no-op stub).

model WhaleFollow {
  id            String    @id
  userId        String
  address       String
  chain         String    @default("eth")
  label         String?
  threshold     Float     @default(0)          // min USD moved to trigger an alert
  isActive      Boolean   @default(true)
  lastSeenTx    String?
  lastSeenBlock BigInt?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, address])
  @@map("whale_follows")
}

// ─── TRADES (v3-fixes) ───────────────────────────────────────────────────────
// Imported CEX (and later on-chain) trade history — the foundation for
// cost-basis, realized/unrealized P&L, and performance analytics.
// Idempotent import: `id` is deterministic (userId:exchangeId:tradeId).

model Trade {
  id           String   @id
  userId       String
  exchangeId   String?
  chain        String?
  symbol       String
  side         String   // buy | sell
  price        Float
  amount       Float
  cost         Float
  fee          Float    @default(0)
  feeCurrency  String?
  timestamp    DateTime
  tradeId      String?
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("trades")
}

model PortfolioSnapshot {
  id          String   @id @default(uuid())
  userId      String
  totalUsd    Decimal  @db.Decimal(24, 8)
  dexUsd      Decimal  @db.Decimal(24, 8)
  defiUsd     Decimal  @db.Decimal(24, 8)
  cexUsd      Decimal  @db.Decimal(24, 8)
  debtUsd     Decimal  @db.Decimal(24, 8)
  realizedPnl Decimal? @db.Decimal(24, 8)
  unrealizedPnl Decimal? @db.Decimal(24, 8)
  freshnessMs Int
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("portfolio_snapshots")
}

model DefiPosition {
  id               String   @id @default(uuid())
  userId           String
  walletAddress    String
  chain            String
  protocol         String
  protocolAddress  String?
  positionType     String
  suppliedUsd      Decimal  @default(0) @db.Decimal(24, 8)
  debtUsd          Decimal  @default(0) @db.Decimal(24, 8)
  netUsd           Decimal  @default(0) @db.Decimal(24, 8)
  apy              Decimal? @db.Decimal(12, 6)
  rewardsUsd       Decimal? @db.Decimal(24, 8)
  healthFactor     Decimal? @db.Decimal(18, 8)
  liquidationPrice Decimal? @db.Decimal(24, 8)
  source           String
  sourceUpdatedAt  DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, chain, protocol])
  @@index([walletAddress, chain])
  @@map("defi_positions")
}

model CexAsset {
  id              String        @id @default(uuid())
  userId          String
  connectionId    String
  accountType     String
  symbol          String
  balance         Decimal       @default(0) @db.Decimal(36, 18)
  priceUsd        Decimal       @default(0) @db.Decimal(24, 8)
  valueUsd        Decimal       @default(0) @db.Decimal(24, 8)
  sourceUpdatedAt DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection      CexConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([userId, connectionId, accountType])
  @@map("cex_assets")
}
